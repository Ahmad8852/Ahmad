}

----------------------------------------------------------------------
-- Sound hooks. rbxasset:// sounds ship with the Roblox client. Swap for your own SFX ids.
----------------------------------------------------------------------
Config.SOUNDS = {
	buy = "rbxasset://sounds/electronicpingshort.wav",
	collect = "rbxasset://sounds/button.wav",
	reveal = "rbxasset://sounds/victory.wav",
